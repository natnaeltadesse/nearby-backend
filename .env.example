# Copy to .env (`make setup` does this for you) and fill in the placeholders.
# The Makefile `include`s this file, so keep it to plain KEY=value lines:
# no quotes, no spaces around `=`, no `$` or `#` inside values.

# ---------------------------------------------------------------- server
HTTP_PORT=8081
ENV=development
LOG_LEVEL=debug
# auto | always | never — auto colours only when stdout is a terminal.
LOG_COLOR=auto
# Serves GET /docs (Swagger UI) and GET /openapi.yaml.
DOCS_ENABLED=true
# Comma-separated origins for the web clients; "*" is development-only.
CORS_ALLOWED_ORIGINS=*

# ---------------------------------------------------------------- database
# Host port is 5433 on purpose: another Postgres already owns 5432.
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking
POSTGRES_PORT=5433
DATABASE_URL=postgres://booking:booking@localhost:5433/booking?sslmode=disable
DATABASE_MAX_CONNS=10

# ---------------------------------------------------------------- auth
# Dev-only secret. Generate a real one with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-6f1c8a2b9e4d7f30a5c1b8e2d9f4a7c30
JWT_ISSUER=booking-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_WEB=720h
REFRESH_TOKEN_TTL_MOBILE=2160h

# ---------------------------------------------------------------- scheduling
DEFAULT_TIMEZONE=Africa/Addis_Ababa
SLOT_STEP_MINUTES=15
MIN_LEAD_MINUTES=30
AVAILABILITY_CACHE_TTL=60s

# ---------------------------------------------------------------- media (milestone 9)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=booking

# ---------------------------------------------------------------- payments (milestone 11)
CHAPA_SECRET_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
PAYMENT_CALLBACK_BASE_URL=http://localhost:8081
